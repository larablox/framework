{
	// Compiles the shadow tree `scripts/build/transform-magic-dispatch.mjs`
	// writes to `.magic-dispatch/src/` (a mirror of `src/`, gitignored,
	// generated on every build) instead of `src/` directly -- rootDir/baseUrl
	// retargeted so imports like "Illuminate/Support/..." still resolve,
	// everything else inherited as-is. tests/ shadows into `.magic-dispatch/
	// tests/` instead, never read here -- this is the package build,
	// tsconfig.tests.json is the one that reads both.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": ".magic-dispatch/src",
		"baseUrl": ".magic-dispatch/src"
	},
	"include": [".magic-dispatch/src/**/*.ts"]
}
