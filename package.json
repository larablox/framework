{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@larablox/framework",
    "version": "0.2.1",
    "description": "The Larablox Framework.",
    "license": "MIT",
    "keywords": [
        "framework",
        "larablox",
        "roblox-ts",
        "laravel"
    ],
    "homepage": "https://github.com/larablox/framework",
    "repository": {
        "type": "git",
        "url": "https://github.com/larablox/framework.git"
    },
    "bugs": {
        "url": "https://github.com/larablox/framework/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "index.d.ts",
        "out/Illuminate",
        "out/Larablox"
    ],
    "types": "index.d.ts",
    "type": "module",
    "scripts": {
        "build": "node scripts/lint/check-packed-args.mjs && node scripts/build/transform-magic-dispatch.mjs && rbxtsc -p tsconfig.magic-dispatch.json",
        "clean": "rimraf out out-tests include tsconfig.tsbuildinfo .magic-dispatch reports",
        "watch": "node scripts/build/watch.mjs",
        "dev": "npm run watch",
        "test:build": "node scripts/build/transform-magic-dispatch.mjs && rbxtsc -p tsconfig.tests.json --rojo test.project.json && node scripts/lune/patch-requires.mjs",
        "test:lune": "lune run scripts/lune/RunTests",
        "test:parity": "node --test scripts/parity/*.test.mjs",
        "test:transform": "node --test scripts/build/*.test.mjs",
        "parity": "node scripts/parity/aggregate.mjs --out=reports/parity/all.csv",
        "test": "npm run test:parity && npm run test:transform && npm run test:build && npm run test:lune"
    },
    "devDependencies": {
        "@rbxts/compiler-types": "^3.0.0-types.0",
        "@rbxts/testez": "^0.4.2-ts.0",
        "@rbxts/types": "^1.0.943",
        "rimraf": "^6.1.3",
        "roblox-ts": "^3.0.0",
        "typescript": "^5.9.3"
    }
}
