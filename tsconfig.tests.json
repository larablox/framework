{
	"compilerOptions": {
		// required (mirrors tsconfig.json)
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts", "node_modules/@larablox"],

		// `src` and `tests` are merged into one virtual directory instead of
		// `rootDir`, for the same reason `@larablox/monolog`'s
		// `tsconfig.tests.json` does it -- see that file's comment. `rootDirs`
		// lets TypeScript treat `src/Illuminate/X.ts` and
		// `tests/Illuminate/X.spec.ts` as if both lived under one
		// `Illuminate/...` directory, so every spec lands right next to the
		// class it covers in `out-tests/Illuminate/...`.
		"rootDirs": ["src", "tests"],
		"outDir": "out-tests",
		"baseUrl": "src",
		// NOT `"declaration": true`, unlike `tsconfig.json`. Declarations are
		// there because the published package needs them; `out-tests/` is a
		// Studio place that nothing imports from, so emitting them here would
		// only cost build time.
		"incremental": true,
		"tsBuildInfoFile": "out-tests/tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
