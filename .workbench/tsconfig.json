{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		// roblox-ts refuses a scoped deep import unless the scope directory is
		// listed here, and TypeScript then tries to auto-load every package
		// under it as an implicit type library -- which is what the framework's
		// checked-in `index.d.ts` exists to satisfy. See the root `CLAUDE.md`.
		"typeRoots": ["node_modules/@rbxts", "node_modules/@larablox"],
		// The framework is linked in from the repository above (see
		// `scripts/link-framework.mjs`). Without this, TypeScript resolves the
		// link to its real path, `../out`, and then decides the package's root
		// is the repository -- which *contains* this workbench, so the
		// workbench's own modules get classified as living inside
		// `node_modules/@larablox/framework` and roblox-ts cannot place them.
		"preserveSymlinks": true,

		// configurable
		"rootDir": "src",
		"outDir": "out",
		"baseUrl": "src",
		"incremental": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
	},
	// The framework's declarations are listed so that they are *in the program*
	// rather than pulled in one file at a time by whatever happens to be
	// imported. Without this an IDE has nothing to offer: the package entry,
	// `index.d.ts`, is `export {}` on purpose, and everything real lives at
	// paths nothing advertises. It cannot be fixed with a barrel -- see the
	// note in the framework's own `index.d.ts`.
	"include": [
		"src/**/*.ts",
		"node_modules/@larablox/framework/out/Illuminate/**/*.d.ts"
	]
}
