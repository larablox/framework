{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@larablox/framework",
    "version": "0.2.1",
    "description": "The Larablox Framework.",
    "license": "MIT",
    "keywords": [
        "framework",
        "larablox",
        "roblox-ts",
        "laravel"
    ],
    "homepage": "https://github.com/larablox/framework",
    "repository": {
        "type": "git",
        "url": "https://github.com/larablox/framework.git"
    },
    "bugs": {
        "url": "https://github.com/larablox/framework/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "index.d.ts",
        "out/Illuminate"
    ],
    "types": "index.d.ts",
    "type": "module",
    "scripts": {
        "build": "rbxtsc",
        "clean": "rimraf out include tsconfig.tsbuildinfo",
        "watch": "rbxtsc -w",
        "dev": "npm run watch"
    },
    "devDependencies": {
        "@rbxts/compiler-types": "^3.0.0-types.0",
        "@rbxts/types": "^1.0.943",
        "rimraf": "^6.1.3",
        "roblox-ts": "^3.0.0",
        "typescript": "^5.9.3"
    }
}
